{
  "name": "f35-a",
  "private": true,
  "version": "1.0.0",
  "description": "F35-A — mobile browser combat flight simulator",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "voices": "bash tools/gen-voices.sh"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  }
}

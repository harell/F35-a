{
  "name": "f35-a",
  "private": true,
  "version": "1.0.0",
  "description": "F35-A — mobile browser combat flight simulator",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && VITE_TEST_HOOKS=1 vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --testTimeout=30000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "e2e": "node e2e/missions.mjs",
    "voices": "bash tools/gen-voices.sh",
    "build:artifact": "vite build && node tools/build-artifact.mjs",
    "icons": "node tools/gen-icons.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  }
}
